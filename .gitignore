/build/
/build-vs/
/build-vs-aerv2/
/build-cuda/
/build-cuda-vs/
/.vs/
/.vscode/
/out/
*.suo
*.user
*.log
*.cbv.tsv
CyberpunkVRProxy.live.txt
CyberpunkVRProxy.log
# tools/ is scratch, with one exception. Note the glob: `tools/` would exclude the directory
# itself and git never descends into an excluded directory, so the negation below would not fire.
tools/*
!tools/xr_probe/
!tools/crash/
!tools/ent/
releases/
*.py
# The per-view capture analysis tools, kept for the same reason tools/crash and tools/ent are:
# they were written twice already because the scratch copies went with a Windows reinstall.
!tools/rdc_*.py
!tools/ida_ssr_probe.py
!tools/ida_findconst.py
!tools/ida_sky_probe.py
memory/
package.json
.opencode/*
!.opencode/memory/
!.opencode/memory/*.md
*.zip
*.ps1
# ...except the probe layer install scripts, which are part of the tool,
!tools/xr_probe/*.ps1
# the install/uninstall pair, which is how the mod is meant to be deployed,
!scripts/deploy_stereo.ps1
!scripts/revert_stereo.ps1
!scripts/sync_assets.ps1
!scripts/build_dist.ps1
# and the asset generator, which authors the VRCAM components the launcher offers.
!tools/gen_vrcam_assets.py
# and the crash-dump reader, which is how a tester's .dmp gets turned into a stack.
!tools/crash/read_dump.py
# and the entity-template editors: the player's hand carriers and the item entities are BUILT by
# these, so without them the archive cannot be reproduced from source.
!tools/ent/*.py

# Runtime diagnostic dumps (moved out of repo root)
/dumps/
*.live.txt

# red4ext plugin build artifacts
src/red4ext_plugin/build/

# OS junk
.DS_Store
**/.DS_Store

# Runtime-generated config / bridge files inside CET mod folders
mods/cet/**/hud_layout.ini
mods/cet/**/hud_scale.txt
mods/cet/**/vrik_settings.ini
mods/cet/**/vrik_recenter.ini

# Release staging / packaging output
/dist/

# Local changelog (kept on disk, not tracked)
/CHANGELOG.md

# Local working backups
/_pre_aer_restore_*/

# Reverse-engineering dumps (IDA / RE research, large; kept out of the repo)
/engine_re/
/render_camera_RE/
/weapons_RE/

# Testbed harness + its build output (kept out of the release repo)
/build-testbed/
/testbed/

# Large third-party reference PDFs (GDC / SIGGRAPH talks; kept out of the repo)
/docs/external/
# Claude Rewind Tool
.claude-rewind/

# Stereo-plugin build output
/build-stereo/

# Working trees and dumps that were never meant to be tracked -- they showed as untracked for
# weeks and everyone assumed they were ignored, which is the same as ignored right up until
# someone runs `git add .` and commits 58 MB.
.claude/
.review_diff.patch
StringsFromCP.txt
externals/OpenXR-SDK/
vr2/

# Review artefacts: the full diff and the commit text prepared for a release.
# Generated, large (the 0.1.6 patch alone is 1.3 MB) and never part of the tree.
/review/
