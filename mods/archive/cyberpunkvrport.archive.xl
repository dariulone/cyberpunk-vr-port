# The port's only manifest, in ArchiveXL's format, for its only archive (cyberpunkvrport.archive, which
# carries everything: player cameras and the optics catalogue, props, magazines, the basketball,
# the monowire material and the physical-crouch animgraph). The plugin applies it
# (src/Core/ArchiveExtensions.cpp): factories, animations and resource patches.
#
# WITHOUT THE FACTORIES THE ITEM ROUTE IS SILENTLY DEAD. An item whose `entityName` is a factory
# name -- Items.VRPortLoadOverture (the Overture's speedloader), Items.VRPortHlTest and
# Items.VRSmokeWheel (vr_smoke_wheel -> vrcigarette\vr_wheel.ent) -- resolves that name through a
# factory csv, and a name that resolves to nothing does not fail loudly: the game's
# `AddItemToSlot` returns TRUE and leaves the slot empty. Measured 2026-09-02: both items reported
# a successful attach and `GetItemInSlot` came back null.
#
# The csvs must stay COOKED C2dArrays (that is how mods\archive\build\base\vrport\vrp_props.csv
# is built): the factory index reads a text csv as zero rows, and the name again resolves to nothing.
#
# Installed as red4ext\plugins\cyberpunkvrport\config\archive.yaml -- never as *.xl beside the archive,
# where ArchiveXL (if installed for other mods) would apply it a second time.
factories:
  - base\vrport\vrp_props.csv
  - vrcigarette\vr_wheel.csv

# The lobby's construct: one more appearance, vrport_construct (the gold hologram), on the body
# meshes the main menu's puppet wears -- added from a patch mesh per mesh, each with that mesh's
# chunk count; the game's meshes keep all they had. The arms and the figure in the lobby's pod
# are not patched: their meshes preload every appearance's materials before a patch's material
# is known, so the construct has its own copies of them instead. Built by
# tools/vr_lobby_assets/make_construct.py, worn while the lobby is up (CyberpunkVRPort_Lobby).
resource:
  patch:
    # The lobby's place: the game's own VR tutorial location -- Night City's q000 sectors (under Japantown),
    # the game's files as they are -- merged as one more streaming block into the main menu's world, where they
    # stream round the player the way they do in Night City's. Built by tools/vr_lobby_assets/tutorial_lobby.py.
    vrport\tutorial\q000_tutorial.streamingblock:
      - base\worlds\04_main_menu\_compiled\default\04_main_menu.streamingworld
    vrport\construct\n0_000_pwa_fpp__neck.mesh:
      props: [appearances]
      targets:
        - base\characters\common\player_base_bodies\player_female_average\fpp\n0_000_pwa_fpp__neck.mesh
    vrport\construct\l0_000_pwa_base__cs_flat.mesh:
      props: [appearances]
      targets:
        - base\characters\common\player_base_bodies\player_female_average\l0_000_pwa_base__cs_flat.mesh
    vrport\construct\t0_000_pwa_base__full.mesh:
      props: [appearances]
      targets:
        - base\characters\common\player_base_bodies\player_female_average\t0_000_pwa_base__full.mesh
    # The man's body (the lobby's own: mods/tweaks/vrport/VRPort.LobbyBody.yaml) and the shoes it stands in.
    vrport\construct\n0_000_pma_fpp__neck.mesh:
      props: [appearances]
      targets:
        - base\characters\common\player_base_bodies\player_man_average\fpp\n0_000_pma_fpp__neck.mesh
    vrport\construct\t0_000_pma_base__full.mesh:
      props: [appearances]
      targets:
        - base\characters\common\player_base_bodies\player_man_average\t0_000_pma_base__full.mesh
    vrport\construct\s1_010_pma_shoe__elegant.mesh:
      props: [appearances]
      targets:
        - base\characters\garment\player_equipment\feet\s1_010_shoe__elegant\s1_010_pma_shoe__elegant.mesh

# >>> left-handed weapon animations (tools/lefthanded_anims/generate.py)
