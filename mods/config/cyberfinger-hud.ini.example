; CyberFinger HUD defaults captured from the live Quest Pro session, 2026-11-15.
; Merge into config/vrport.ini. The installer seeds only missing keys by default.
; -ResetHudDefaults deliberately reapplies these HUD settings to an existing install.
; Values use the same precision as the F10 Save function. No transient hide/show state.
; Layout: horizontal %, vertical %, scale, opacity, visible (0/1).
xr_hud_panel=1
xr_hud_follow_deg=60.000
xr_interaction_panel=1
xr_interaction_follow_deg=0.000
xr_loot_follow_deg=0.000
xr_interaction_distance=0.840
xr_interaction_fov=57.500
xr_hud_fov=56.200
xr_hud_distance=1.170
xr_hud_follow_mode=0
xr_hud_stereo_depth=1
xr_hud_brightness=1.000
xr_hud_shadow=1.000
xr_hud_glow=1.000
xr_hud_clearance=1
xr_hud_clearance_grow=0.510
xr_hud_clearance_hands=0
xr_hud_clearance_hands_scale=2.000
xr_interaction_anchor=0
