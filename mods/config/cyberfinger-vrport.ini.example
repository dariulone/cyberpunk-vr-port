; Merge these keys into the plugin's config/vrport.ini; do not replace the file.
; Requires config/cyberfinger.ini with enabled=1 and the guide's SteamVR binding.
; Captured HUD defaults are in cyberfinger-hud.ini.example; the installer seeds
; missing HUD keys, or reapplies them explicitly with -ResetHudDefaults.
xr_input_actions=1
xr_xinput_hook=1
xr_finger_bones=1
xr_grip_from_fingers=1
xr_vive_trackers=1

; Weapon hand: 1 = LEFT (this preset), 0 = RIGHT.
; Also configurable live under Controls > Left-handed controls.
xr_left_handed=1

; Left-hand firearm combat trades stick axes so the right stick can strafe while the left fires.
; The default sword-hand preference can be changed under Controls > General.
; With a left firearm, left trigger fires and right trigger aims.
; 1 = also mirror face buttons; 2 = also mirror sticks/clicks (right stick moves).
xr_left_handed_bindings=0

; CyberFinger gesture stowing. Uncomment to override a default (0 = off, 1 = on).
; xr_cyberfinger_gun_gesture_holstering=0
; xr_cyberfinger_melee_gesture_holstering=1
; CyberFinger immersive weapon holsters and tactical belt grenade holder
; xr_cyberfinger_holster_handguns=0
; xr_cyberfinger_holster_machine_guns=0
; xr_cyberfinger_holster_shotguns=0
; xr_cyberfinger_holster_knives=1
; xr_cyberfinger_holster_grenades=1
; xr_cyberfinger_holster_swords=1
; xr_cyberfinger_holster_rifles=0
; xr_cyberfinger_holster_other_melee=1
