+// 2.5 (3.0.88) renumbered the scopes (2.31: Patch 3, Mod 4); see the game's scope -> folder mapping (hash 1525423808).
 enum class ArchiveScope : uint32_t
 {
     Invalid = 0,
     Content = 1, // archive\pc\content
-    DLC = 2,     // archive\pc\dlc
-    Patch = 3,   // archive\pc\patch
-    Mod = 4,     // archive\pc\mod + mods\*\archives
+    DLC = 2,     // archive\pc\ep1
+    Unk3 = 3,    // no folder
+    Patch = 4,   // archive\pc\patch
+    Patch2 = 5,  // archive\pc\patch, loaded before Patch
+    Mod = 6,     // archive\pc\mod + mods\*\archives + mod.io mods
 };
 
 struct ArchiveGroup
