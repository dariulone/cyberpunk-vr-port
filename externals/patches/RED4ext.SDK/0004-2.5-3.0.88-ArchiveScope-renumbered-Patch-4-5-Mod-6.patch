 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/include/RED4ext/ResourceDepot.hpp b/include/RED4ext/ResourceDepot.hpp
index 81497685..fd70f327 100644
--- a/include/RED4ext/ResourceDepot.hpp
+++ b/include/RED4ext/ResourceDepot.hpp
@@ -19,13 +19,16 @@ struct Archive
 RED4EXT_ASSERT_SIZE(Archive, 0x50);
